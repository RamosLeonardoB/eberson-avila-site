# Copie este arquivo para .env.local (desenvolvimento) e configure
# as mesmas variáveis em Vercel > Project Settings > Environment Variables
# para produção.

# ID da agenda pública do Google
# (Google Agenda > Configurações da agenda > Integrar agenda > ID da agenda)
GOOGLE_CALENDAR_ID=seu-calendario@group.calendar.google.com

# Chave de API do Google Cloud com a Google Calendar API habilitada
# Restrinja por domínio/IP no Google Cloud Console antes de ir para produção.
GOOGLE_API_KEY=sua-chave-de-api-aqui
